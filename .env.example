# ============================================================================
# GPT Researcher 配置模板
#
# 用法：
#   Windows:  copy .env.example .env
#   Linux/macOS: cp .env.example .env
#   然后填写下面的 Key（或直接运行 provider_setup.py 自动生成）
# ============================================================================

# ---------------------------------------------------------------------------
# 一、模型供应商
#
# 最省事的方式：运行交互脚本，自动写入下面的 >>> 配置块
#   .\.venv\Scripts\python.exe provider_setup.py
#
# 也可以手工编辑。下面默认使用阿里云百炼（通义千问）。
# ---------------------------------------------------------------------------

# >>> provider config managed by provider_setup.py >>>
PROVIDER=dashscope
DASHSCOPE_API_KEY=sk-你的百炼Key
FAST_LLM=dashscope:qwen-flash
SMART_LLM=dashscope:qwen-plus
STRATEGIC_LLM=dashscope:qwen-plus
EMBEDDING=dashscope:text-embedding-v3
CONTEXT_FILTER=auto
# <<< provider config managed by provider_setup.py <<<

# --- 其他供应商参考（复制到上方配置块，或直接用 provider_setup.py 切换） -----

# DeepSeek（无 embedding 接口，自动降级为关键词过滤）
# DEEPSEEK_API_KEY=sk-你的DeepSeekKey
# FAST_LLM=deepseek:deepseek-chat
# SMART_LLM=deepseek:deepseek-chat
# STRATEGIC_LLM=deepseek:deepseek-chat
# EMBEDDING=openai:text-embedding-3-small
# CONTEXT_FILTER=keyword

# 月之暗面 Kimi（OpenAI 兼容接口）
# OPENAI_API_KEY=sk-你的MoonshotKey
# OPENAI_BASE_URL=https://api.moonshot.cn/v1
# FAST_LLM=openai:moonshot-v1-8k
# SMART_LLM=openai:moonshot-v1-32k
# STRATEGIC_LLM=openai:moonshot-v1-32k
# CONTEXT_FILTER=keyword

# 智谱 GLM
# OPENAI_API_KEY=你的智谱Key
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# FAST_LLM=openai:glm-4-flash
# SMART_LLM=openai:glm-4-plus
# STRATEGIC_LLM=openai:glm-4-plus
# EMBEDDING=openai:embedding-3

# 硅基流动 SiliconFlow
# OPENAI_API_KEY=sk-你的SiliconFlowKey
# OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# FAST_LLM=openai:Qwen/Qwen3-8B
# SMART_LLM=openai:Qwen/Qwen3-32B
# STRATEGIC_LLM=openai:Qwen/Qwen3-32B
# EMBEDDING=openai:BAAI/bge-m3

# 火山方舟（豆包）
# OPENAI_API_KEY=你的ARKKey
# OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# FAST_LLM=openai:doubao-1-5-pro-32k-250115
# SMART_LLM=openai:doubao-1-5-pro-32k-250115
# STRATEGIC_LLM=openai:doubao-1-5-pro-32k-250115
# CONTEXT_FILTER=keyword

# OpenAI 官方
# OPENAI_API_KEY=sk-你的OpenAIKey
# FAST_LLM=openai:gpt-4o-mini
# SMART_LLM=openai:gpt-4o
# STRATEGIC_LLM=openai:gpt-4o
# EMBEDDING=openai:text-embedding-3-small

# OpenRouter（聚合）
# OPENROUTER_API_KEY=sk-or-你的Key
# FAST_LLM=openrouter:openai/gpt-4o-mini
# SMART_LLM=openrouter:openai/gpt-4o
# STRATEGIC_LLM=openrouter:openai/gpt-4o
# CONTEXT_FILTER=keyword

# Groq
# GROQ_API_KEY=gsk_你的Key
# FAST_LLM=groq:llama-3.3-70b-versatile
# SMART_LLM=groq:llama-3.3-70b-versatile
# STRATEGIC_LLM=groq:llama-3.3-70b-versatile
# CONTEXT_FILTER=keyword

# 本地 Ollama（无需 Key）
# OLLAMA_BASE_URL=http://localhost:11434
# FAST_LLM=ollama:qwen2.5:7b
# SMART_LLM=ollama:qwen2.5:7b
# STRATEGIC_LLM=ollama:qwen2.5:7b
# EMBEDDING=ollama:nomic-embed-text

# ---------------------------------------------------------------------------
# 二、搜索源（当前固定为博查）
# 注册：https://open.bochaai.com/
# ---------------------------------------------------------------------------
RETRIEVER=bocha
BOCHA_API_KEY=sk-你的博查Key

# ---------------------------------------------------------------------------
# 三、输出与语言
# ---------------------------------------------------------------------------
# 单次输出 token 上限；百炼模型一般 8k，压到 6k 更稳
FAST_TOKEN_LIMIT=3000
SMART_TOKEN_LIMIT=6000
STRATEGIC_TOKEN_LIMIT=4000

# 报告语言（会写进 prompt）
LANGUAGE=Simplified Chinese (简体中文)

# 本地文档模式读取目录
DOC_PATH=./my-docs

# 报告内嵌图片（需要 Google Key，默认关闭）
IMAGE_GENERATION_ENABLED=false

# ---------------------------------------------------------------------------
# 四、可观测性（可选）
# ---------------------------------------------------------------------------
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT="gpt-researcher"

# MONOCLE_TRACING=true
# MONOCLE_EXPORTERS=file